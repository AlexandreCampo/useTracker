plugins/ZonesOfInterest.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/useTracker.dir/build.make CMakeFiles/useTracker.dir/plugins/ZonesOfInterest.cpp.s
.PHONY : plugins/ZonesOfInterest.cpp.s


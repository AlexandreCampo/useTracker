<?xml version="1.0"?>
<!--
  Example useTracker settings: detect and track moving targets (e.g. fish in
  turbid water) and fit each target box to the real shape of its blob.

  Pipeline:
    1. Background Diff Knn  - foreground mask from a KNN background model
    2. Erosion             - remove speckle noise from the mask
    3. Pattern Tracker     - follow each blob by appearance; the bounding box
                             is taken from the mask blob (Fit box to mask) and
                             adapts to its size over time (rate-limited)

  How to run:
    build/useTracker -p examples/fish_pattern_tracking.xml -i yourvideo.mp4
  or, in the GUI:  File -> Load Settings...  then  File -> Open Source...

  What to look for:
    - Each target gets an orange box whose shape/size follows its blob, not a
      fixed square, and does not snap smaller when the blob flickers.
    - Targets are auto-seeded from the mask (Seed from detected blobs). You can
      also tick "Click on video to add targets" in the Pattern Tracker dialog
      and click a target directly.
    - A CSV with time/frame/id/x/y/width/height/score is written to tracks.csv
      in the working directory.

  Tuning (Pattern Tracker dialog):
    - Threshold (Background Diff Knn): lower = more sensitive / more noise.
      400 is a good start; drop it if faint targets are missed.
    - Min Blob Size to Seed: raise to ignore small noise, lower to catch small
      targets. Should roughly match the smallest target's pixel area.
    - Size Adapt Rate: 0 = frozen box size, 1 = snap to the blob instantly.
      0.2 keeps the box steady through brief flicker while still following
      real size changes.
    - Search Distance: max pixels a target may move between frames; raise for
      fast targets.
    - Match Threshold: lower if targets are dropped too easily; raise if boxes
      stick to the background.
    - Switch Backend to CSRT for targets that change scale or rotate a lot.
-->
<opencv_storage>
<Configuration>
  <StartTime>0.</StartTime>
  <DurationTime>0.</DurationTime>
  <Timestep>0.</Timestep>
  <UseTimeBounds>0</UseTimeBounds>
  <BackgroundFilename>""</BackgroundFilename>
  <BackgroundRecalculate>0</BackgroundRecalculate>
  <BackgroundFrames>11</BackgroundFrames>
  <BackgroundStartTime>0.</BackgroundStartTime>
  <BackgroundEndTime>0.</BackgroundEndTime>
  <BackgroundLowThreshold>0</BackgroundLowThreshold>
  <BackgroundHighThreshold>255</BackgroundHighThreshold>
  <BackgroundCalcType>mean</BackgroundCalcType>
  <ZonesFilename>""</ZonesFilename>
  <Pipeline>
    <Plugin_0>
      <BackgroundDiffKnn>
        <Active>1</Active>
        <History>250</History>
        <Threshold>400.</Threshold>
        <ShadowDetection>0</ShadowDetection>
        <LearningRate>-1.</LearningRate>
        <RestrictToZone>0</RestrictToZone>
        <Additive>0</Additive></BackgroundDiffKnn></Plugin_0>
    <Plugin_1>
      <Erosion>
        <Active>1</Active>
        <Size>1</Size></Erosion></Plugin_1>
    <Plugin_2>
      <PatternTracker>
        <Active>1</Active>
        <Output>1</Output>
        <Backend>0</Backend>
        <MaxDistance>50</MaxDistance>
        <TemplateSize>48</TemplateSize>
        <FitToMask>1</FitToMask>
        <SizeAdaptRate>2.0000000000000001e-01</SizeAdaptRate>
        <MatchThreshold>3.0000000000000000e-01</MatchThreshold>
        <UpdateThreshold>6.0000000000000000e-01</UpdateThreshold>
        <UpdateRate>1.0000000000000001e-01</UpdateRate>
        <MaxLostFrames>15</MaxLostFrames>
        <MaxTargets>20</MaxTargets>
        <UsePrediction>1</UsePrediction>
        <TrailLength>30</TrailLength>
        <SeedFromDetection>1</SeedFromDetection>
        <MinBlobSeedSize>200</MinBlobSeedSize>
        <Additive>0</Additive>
        <OutputFilename>"tracks.csv"</OutputFilename></PatternTracker></Plugin_2>
  </Pipeline>
</Configuration>
</opencv_storage>

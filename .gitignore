# Build directories / CMake output
/build/
build/
build-*/
AppDir/

# Packaged artifacts
/dist/
*.AppImage
*.deb
*.rpm
*.dmg

# Compiled objects, libraries, dependency files
*.o
*.a
*.d
*.obj
*.lo
*.slo

# Editor / IDE
compile_commands.json

# Runtime-generated UI layout (regenerated on every run)
imgui.ini

# Local runtime output / scratch
blobs.csv
settings.xml

# The executable
/useTracker

# Python bytecode
__pycache__/
*.pyc

# Sample footage — large media belongs outside the repository
*.MP4
*.mp4
*.avi
*.mov
*.mkv

# Website — kept in this working tree for convenience, but versioned in its own
# private repository. Ignoring it here also stops git treating the nested repo
# as a gitlink.
website/
